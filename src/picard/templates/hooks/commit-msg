#!/usr/bin/env sh
# Tier 0a: reject a commit message that is not a valid Conventional Commit.
# The ticket ID is only required on the PR title (that is what squash merge keeps), so it
# is not required here.
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! command -v picard >/dev/null 2>&1; then
  echo "picard is not installed, and this hook needs it." >&2
  echo "Install it from a clone of the picard repository: uv tool install --editable <clone>" >&2
  echo "(bypass once with --no-verify; CI re-checks everything)" >&2
  exit 1
fi
exec picard check-title --file "$1" --no-ticket
